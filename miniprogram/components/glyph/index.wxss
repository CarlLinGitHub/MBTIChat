:host { display: inline-flex; flex: none; }
.icon { position: relative; width: 1em; height: 1em; flex: none; color: inherit; }
.one,.two,.three,.mark { position: absolute; box-sizing: border-box; line-height: 1; }
.house .one { inset: 43% 13% 9%; border: .0625em solid; border-top: 0; border-radius: 0 0 .08em .08em; }
.house .two { width: 54%; height: 54%; left: 23%; top: 17%; border-top: .0625em solid; border-left: .0625em solid; border-radius: .05em 0 0; transform: rotate(45deg) skew(-7deg,-7deg); }
.chat .one,.help .one { inset: 7% 4% 15%; border: .0625em solid; border-radius: 52%; }
.chat .two,.help .two { width: 25%; height: 19%; left: 18%; top: 69%; border-left: .0625em solid; border-bottom: .0625em solid; border-radius: 0 0 0 40%; background: inherit; transform: skewY(-28deg); }
.chat .mark { inset: 31% 0 auto; text-align: center; font-size: .31em; letter-spacing: .06em; }
.help .mark { inset: 19% 0 auto; text-align: center; font-size: .6em; }
.person .one,.people .one,.block .one { width: 41%; height: 41%; top: 4%; left: 29%; border: .0625em solid; border-radius: 50%; }
.person .two,.people .two,.block .two { inset: 46% 8% 8%; border: .0625em solid; border-radius: 60% 60% 26% 26% / 90% 90% 24% 24%; }
.people .one { left: 15%; }
.people .two { left: 1%; right: 25%; }
.people .three { inset: 13% 4% 14% 70%; border: .0625em solid; border-bottom: 0; border-left: 0; border-radius: 0 80% 65% 0; transform: skewY(19deg); }
.chevron .one { width: 45%; height: 45%; left: 18%; top: 27%; border-top: .065em solid; border-right: .065em solid; border-radius: .045em; transform: rotate(45deg); }
.search .one { width: 71%; height: 71%; top: 4%; left: 4%; border: .0625em solid; border-radius: 50%; }
.search .two { width: 42%; height: .067em; top: 76%; left: 59%; background: currentColor; transform: rotate(45deg); border-radius: .04em; }
.favorite .one { inset: 5% 16% 7%; border: .0625em solid; border-radius: 16% 16% 8% 8%; }
.favorite .mark { inset: 21% 0 auto; text-align: center; font-size: .56em; }
.bell .one { inset: 12% 17% 24%; border: .0625em solid; border-radius: 55% 55% 16% 16% / 92% 92% 14% 14%; }
.bell .two { width: 22%; height: 15%; top: 76%; left: 39%; border: .0625em solid; border-radius: 0 0 50% 50%; }
.bell .three { width: 14%; height: 14%; top: 1%; left: 43%; border: .055em solid; border-radius: 50% 50% 0 0; }
.shield .one { inset: 6% 13% 7%; border: .0625em solid; border-radius: 24% 24% 50% 50% / 20% 20% 72% 72%; }
.shield .two { width: 37%; height: 21%; top: 34%; left: 32%; border-left: .0625em solid; border-bottom: .0625em solid; border-radius: .05em; transform: rotate(-45deg); }
.block .one { left: 22%; }
.block .two { right: 27%; }
.block .mark { width: 44%; height: 44%; bottom: 3%; right: 2%; border: .14em solid; border-radius: 50%; font-size: .44em; line-height: .73; text-align: center; background: #faf6f4; }
.megaphone .one { inset: 16% 11% 26% 15%; border: .0625em solid; border-radius: 25% 10% 10% 25%; transform: skewY(-13deg); }
.megaphone .two { inset: 63% 51% 7% 29%; border: .0625em solid; border-top: 0; border-radius: 0 0 22% 46%; transform: skewX(14deg); }
.plus .one { inset: 2%; border: .06em solid; border-radius: 50%; }
.plus .two { inset: 46% 24%; background: currentColor; border-radius: .04em; }
.plus .three { inset: 24% 46%; background: currentColor; border-radius: .04em; }
.send .one { inset: 22% 15% 13% 15%; background: currentColor; clip-path: polygon(0 39%, 100% 0, 76% 100%, 55% 71%, 39% 92%, 38% 64%, 80% 22%, 28% 54%); }
