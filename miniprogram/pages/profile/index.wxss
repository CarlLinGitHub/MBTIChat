.profile-screen { padding-top: 37rpx; }
.profile { min-height: 207rpx; padding: 21rpx 17rpx; gap: 19rpx; margin-bottom: 40rpx; }
.profile-avatar { width: 145rpx; height: 145rpx; }
.fallback { display: flex; align-items: center; justify-content: center; color: #8766a0; }
.identity { flex-wrap: wrap; gap: 5rpx 13rpx; }
.name { max-width: 100%; font-size: 40rpx; font-weight: 750; }
.bio { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: 24rpx; }
.profile button.edit { flex: none; width: 148rpx; margin: 0 0 30rpx; padding: 9rpx 0; font-size: 23rpx; }
.menu { padding: 0 18rpx; margin-bottom: 26rpx; }
.menu button.item { display: flex; width: 100%; min-height: 86rpx; margin: 0; padding: 10rpx 10rpx 10rpx 17rpx; gap: 30rpx; text-align: left; }
.item + .item { border-top: 1px solid #e5d9dc; }
.item-label { font-size: 30rpx; font-weight: 650; }
.account { padding: 0 15rpx; font-size: 22rpx; }
