page { height: 100%; overflow: hidden; }
.chat { height: 100%; display: flex; flex-direction: column; position: relative; }
.room-header { padding: 12rpx 21rpx 0; border-top: 1px solid #ece2e4; }
.room-header button.participants { display: flex; width: 100%; min-height: 76rpx; gap: 20rpx; margin: 0; padding: 0 9rpx; text-align: left; }
.online { gap: 14rpx; font-size: 29rpx; white-space: nowrap; }
.member-avatar { width: 54rpx; height: 54rpx; }
.avatars .member-avatar + .member-avatar { margin-left: -4rpx; }
.fallback { display: flex; align-items: center; justify-content: center; color: #8766a0; }
.announcement { gap: 15rpx; margin: 8rpx 0 0; padding: 15rpx 24rpx; min-height: 72rpx; max-height: 132rpx; overflow: auto; align-items: flex-start; border-radius: 21rpx; background: #eee5fa; font-size: 27rpx; white-space: pre-wrap; overflow-wrap: anywhere; }
.announcement-title { font-weight: 660; }
.connection { font-size: 21rpx; text-align: center; padding: 5rpx 12rpx 0; }
.history { flex: 1; min-height: 0; height: 0; }
.history-body { padding: 14rpx 22rpx 21rpx; }
.history-control { width: 100%; font-size: 23rpx; }
.timestamp { margin: 11rpx 0 19rpx; font-size: 24rpx; color: #827586; text-align: center; }
.message { display: flex; align-items: flex-start; gap: 15rpx; margin: 8rpx 0 29rpx; }
.sender-avatar { width: 93rpx; height: 93rpx; }
.message-main { min-width: 0; max-width: calc(100% - 120rpx); }
.sender { gap: 10rpx; margin: -1rpx 0 8rpx; font-size: 23rpx; font-weight: 600; }
.sender-mbti { color: #234940; background: #dcebe0; font-size: 20rpx; }
.bubble { display: block; position: relative; width: fit-content; max-width: 100%; padding: 15rpx 21rpx; border-radius: 21rpx; background: #efeae9; font-size: 29rpx; white-space: pre-wrap; word-break: break-word; }
.bubble::before { content: ''; position: absolute; top: 22rpx; left: -6rpx; width: 13rpx; height: 13rpx; background: inherit; transform: rotate(45deg); }
.mine { justify-content: flex-end; }
.mine .message-main { display: flex; flex-direction: column; align-items: flex-end; }
.mine .bubble { background: #eee2fa; }
.mine .bubble::before { left: auto; right: -6rpx; }
.concealed { justify-content: center; }
.concealed .bubble { padding: 6rpx 17rpx; color: #746576; font-size: 22rpx; }
.concealed .bubble::before { display: none; }
.picture { display: block; width: 235rpx; max-width: 100%; border-radius: 16rpx; background: #eee9f0; }
.pending-label, .retry { margin-top: 5rpx; font-size: 21rpx; }
.retry { color: #994360; }
.end-marker { height: 1px; }
.compose-wrap { position: relative; flex: none; border-top: 1px solid #e5dbdf; }
.newest { position: absolute; right: 25rpx; top: -64rpx; padding: 8rpx 16rpx; font-size: 22rpx; }
.composer { gap: 16rpx; padding: 13rpx 22rpx calc(13rpx + env(safe-area-inset-bottom)); background: #faf6f4; }
.composer button { display: flex; justify-content: center; align-items: center; margin: 0; padding: 0; }
.composer button.add { flex: 0 0 58rpx; width: 58rpx; height: 62rpx; }
.composer input.draft { flex: 1 1 0; width: 0; height: 62rpx; padding: 0 24rpx; border-radius: 999rpx; background: #eeeaee; font-size: 27rpx; }
.draft-placeholder { color: #807684; }
.composer button.send { flex: 0 0 60rpx; width: 60rpx; height: 60rpx; border-radius: 50%; background: #8f62cd; color: #fff; }
.composer button.send[disabled] { color: #fff; background: #9c73d3; opacity: 1; }
.join-card { margin: 37rpx 22rpx; padding: 25rpx; }
.join-name { font-size: 34rpx; font-weight: 700; }
.intro { margin-top: 8rpx; }
.join-tip { margin: 19rpx 0; font-size: 24rpx; }
.sheet-layer { position: absolute; z-index: 5; inset: 0; }
.scrim { position: absolute; inset: 0; background: rgba(38, 20, 48, .28); }
.sheet { position: absolute; inset: auto 0 0; background: #faf6f4; border-radius: 26rpx 26rpx 0 0; padding: 18rpx 23rpx calc(20rpx + env(safe-area-inset-bottom)); }
.sheet-header { padding-bottom: 12rpx; gap: 8rpx; }
.sheet-title { font-size: 34rpx; font-weight: 700; }
.close { padding: 0 12rpx; }
.member-list { max-height: 36vh; }
.member { width: 100%; text-align: left; min-height: 75rpx; padding: 9rpx 8rpx; gap: 13rpx; border-top: 1px solid #e4dadd; }
.member-empty { padding: 14rpx 0; }
.sheet-actions { margin-top: 17rpx; gap: 14rpx; }
.leave { color: #994360; }
