.section { margin-bottom: 18rpx; padding: 22rpx; }
.avatar-choices { flex-wrap: wrap; gap: 12rpx; margin: 8rpx 0 14rpx; }
.avatar-choice { padding: 4rpx; border: 2rpx solid transparent; border-radius: 50%; }
.avatar-choice.chosen { border-color: #7948bc; }
.choice-image { width: 77rpx; height: 77rpx; }
.field-label { margin: 15rpx 0 8rpx; font-size: 29rpx; font-weight: 650; }
.toggle-label { margin-top: 0; }
.field { width: 100%; height: 68rpx; padding: 10rpx 17rpx; border-radius: 16rpx; background: #eee9f0; }
.bio { height: 130rpx; }
.feedback { height: 190rpx; }
.action { width: 100%; margin-top: 16rpx; }
.hint { font-size: 25rpx; }
.list-item { min-height: 105rpx; padding: 13rpx 19rpx; gap: 16rpx; }
.list-main { gap: 13rpx; font-weight: 600; }
.list-cover { width: 72rpx; height: 72rpx; border-radius: 16rpx; }
.list-avatar { width: 66rpx; height: 66rpx; }
.remove { padding: 6rpx 18rpx; flex: none; font-size: 24rpx; }
